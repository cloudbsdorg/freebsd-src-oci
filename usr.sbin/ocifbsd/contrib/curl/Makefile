# Vendored libcurl (curl license, permissive) built as a private static library
# for ocifbsd, so the tree builds without the curl port. Upstream 8.21.0; see
# COPYING. Configured minimally: HTTP/HTTPS only, TLS via FreeBSD base OpenSSL,
# no third-party libraries (no nghttp2/idn2/psl/ssh2/brotli/zstd/zlib). The
# curl_config.h under lib/ was generated by curl's own ./configure on FreeBSD
# with --with-openssl=/usr --with-ca-bundle=/etc/ssl/cert.pem and all the
# extra protocols/backends disabled.

LIB=	ocifbsd_curl
INTERNALLIB=	yes

# curl sources include lib-level and subdir headers relative to lib/ (e.g.
# "urldata.h", "vtls/openssl.h"), and the public API as <curl/curl.h>.
.PATH:	${.CURDIR}/lib ${.CURDIR}/lib/vtls ${.CURDIR}/lib/vauth \
	${.CURDIR}/lib/vquic ${.CURDIR}/lib/vssh ${.CURDIR}/lib/curlx

CFLAGS+=	-I${.CURDIR}/lib -I${.CURDIR}/include
CFLAGS+=	-DHAVE_CONFIG_H -DBUILDING_LIBCURL

# ocifbsd binaries are PIE, so the archive's objects must be position
# independent to link into them.
CFLAGS+=	-fPIC

# Third-party import: keep upstream warnings from gating our build.
WARNS=	0
NO_WERROR=	yes

SRCS=	\
